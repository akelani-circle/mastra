{
  "name": "circle-payment-agent",
  "version": "1.0.0",
  "description": "An agent that owns a USDC wallet and pays for the services it calls. Searches the Circle Agent Marketplace for an x402 service that can answer your question, checks the price, and settles per call with no API keys, accounts, or prefunded billing.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "akelani-circle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akelani-circle/mastra.git"
  },
  "keywords": [
    "mastra",
    "agent",
    "circle",
    "usdc",
    "x402",
    "payments",
    "stablecoin"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start"
  },
  "dependencies": {
    "@mastra/core": "latest",
    "@mastra/libsql": "latest",
    "@mastra/loggers": "latest",
    "@mastra/memory": "latest",
    "@mastra/observability": "latest",
    "gray-matter": "^4.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.9",
    "mastra": "latest",
    "typescript": "^5.9.3"
  }
}
