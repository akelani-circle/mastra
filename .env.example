# Powers the agent model.
OPENAI_API_KEY=

# Any model Mastra can route to, with that provider's key set above.
# https://mastra.ai/models/environment-variables
# AGENT_MODEL=openai/gpt-5.6-sol

# For corporate networks with a TLS certificate in the system trust store. Node 22.15+.
# NODE_OPTIONS=--use-system-ca

# Only for a front end of your own: the shared secret for the /circle/* routes, which accept
# Circle's Terms and complete an OTP sign-in for a caller with no shell. Unset means those routes
# refuse every request, which is the right default. `openssl rand -hex 32`.
# CONTROL_PLANE_TOKEN=

# Circle itself needs no API key. You sign in from the chat, and the agent installs the CLI.
